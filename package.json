{
  "name": "portal-saude-municipal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node node_modules/vinext/dist/cli.js dev",
    "build": "node node_modules/vinext/dist/cli.js build",
    "build:static": "vite build --config vite.static.config.ts",
    "start": "node node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern static-dist --ignore-pattern .next --ignore-pattern .node_modules-partial --ignore-pattern tmp --ignore-pattern tmp-browser",
    "db:generate": "drizzle-kit generate",
    "push:keys": "node scripts/generate-vapid-keys.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "drizzle-orm": "0.45.2",
    "magic-string": "^0.30.21",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/workers-types": "^5.20260815.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.1",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.6",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0"
  },
  "type": "module"
}
